# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# images uploaded through the admin in development (the production volume is /data/uploads)
/.uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
Thumbs.db

# third-party theme reference (ModinaTheme PrintNow, not for commit)
/template

# temp screenshot scripts
screenshot*.mjs

# codegraph
.codegraph

# local planning docs (admin CMS design notes) — not committed
/docs/

# page-text parity corpus (generated from a local build; large)
/.parity/

# browser-smoke artifacts (Playwright MCP output and screenshots)
/.playwright-mcp/
/smoke-*.png
