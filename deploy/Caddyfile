# SITE_ADDRESS comes from compose: a hostname (vietdragon.vn) gets automatic HTTPS;
# `http://localhost` serves plain HTTP for a local run.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Cap request bodies before they reach the app: 2 MB everywhere, except the upload route (an image is at most MEDIA_MAX_IMAGE_MB, 11 at the
	# most, plus the form around it). Two disjoint matchers, because a second `request_body` would not raise the first one's limit.
	@upload path /api/admin/content/media
	@not_upload not path /api/admin/content/media
	request_body @not_upload {
		max_size 2MB
	}
	request_body @upload {
		max_size 12MB
	}

	# Fail closed: a new admin page or API path is a 404 until it is added here. Under /admin only the Better Auth
	# console (sign-in, account, users, audit) and the content editors (/admin/content) are public, and under
	# /api/admin only the API behind those editors (/api/admin/content, uploads included) and the preview switch (/api/admin/preview).
	# /api/auth/* is not matched here, so sign-in works.
	@admin_unlisted {
		path /admin /admin/* /api/admin /api/admin/*
		not path /admin /admin/login /admin/login/* /admin/account /admin/account/* /admin/users /admin/users/* /admin/audit /admin/audit/* /admin/content /admin/content/* /api/admin/content /api/admin/content/* /api/admin/preview
	}
	respond @admin_unlisted 404

	# Docker's healthcheck calls the app directly; there is no reason to expose this publicly.
	@health path /api/health
	respond @health 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		# Overwrite, never append: the app trusts this header for rate limiting (Phase 2/6),
		# so a client-supplied value must not survive.
		header_up X-Real-IP {remote_host}
	}
}
