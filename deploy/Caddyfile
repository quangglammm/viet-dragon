# SITE_ADDRESS comes from compose: a hostname (vietdragon.vn) gets automatic HTTPS;
# `http://localhost` serves plain HTTP for a local run.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Cap request bodies before they reach the app. Phase 5 raises this for the upload route only.
	request_body {
		max_size 2MB
	}

	# Fail closed: under /admin only the Better Auth console (sign-in, account, users, audit) and the content
	# editors on the database (/admin/content, and the API behind them, /api/admin/content) are public.
	# The pre-Phase-3 editors (/admin/site-content, products, blog, media, translations) and the legacy
	# /api/admin/* routes behind them write into the source tree, so they stay 404 until Phase 4 deletes
	# them. /api/auth/* is not matched here, so sign-in works.
	@admin_not_ready {
		path /admin /admin/* /api/admin/*
		not path /admin /admin/login /admin/login/* /admin/account /admin/account/* /admin/users /admin/users/* /admin/audit /admin/audit/* /admin/content /admin/content/* /api/admin/content /api/admin/content/*
	}
	respond @admin_not_ready 404

	# Docker's healthcheck calls the app directly; there is no reason to expose this publicly.
	@health path /api/health
	respond @health 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000 {
		# Overwrite, never append: the app trusts this header for rate limiting (Phase 2/6),
		# so a client-supplied value must not survive.
		header_up X-Real-IP {remote_host}
	}
}
