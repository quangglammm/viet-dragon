    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.23",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.5",
    "swiper": "^14.0.5",
