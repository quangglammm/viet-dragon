# Copy to a file outside the repository (chmod 600) and pass it to compose:
#   docker compose --env-file /etc/vietdragon/.env up -d --build
# Secrets are left empty on purpose: compose and lib/env.ts refuse to start without them.
# Passwords end up inside a postgres:// URL — generate URL-safe ones:  openssl rand -hex 24

# --- Production stack (compose.yaml) ---------------------------------------------------------
# Caddy site address. A hostname gets automatic HTTPS; `http://localhost` serves plain HTTP.
SITE_ADDRESS=
# Public origin, no path. Also a docker build arg: it is baked into the prerendered pages.
SITE_URL=
# Postgres owner (runs migrations) and the DML-only role the app connects as. >= 12 characters.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Signs session cookies (Better Auth). At least 32 characters:  openssl rand -hex 32
# Rotating it signs everyone out. Never reuse a value from another environment.
BETTER_AUTH_SECRET=
# Mail for consult leads. Required in production: without it leads would only be logged.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Optional
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
CONSULT_RECEIVER_EMAIL=
LOG_LEVEL=info
# Largest image an editor may upload, in whole megabytes (1-11; default 10). Caddy lets 12 MB through to the upload route, so do not go higher without raising it there.
MEDIA_MAX_IMAGE_MB=10
# Host ports for Caddy, and the image tag (handy for rollbacks).
HTTP_PORT=80
HTTPS_PORT=443
APP_TAG=local

# --- Local development (`pnpm dev` + `docker compose -f compose.dev.yaml up -d`) --------------
# compose.dev.yaml reads POSTGRES_PASSWORD above; `pnpm dev` reads DATABASE_URL, SITE_URL and BETTER_AUTH_SECRET.
# DATABASE_URL=postgres://vietdragon:<POSTGRES_PASSWORD>@127.0.0.1:5432/vietdragon
# SITE_URL=http://localhost:3000
